TARGET_DIR = ./rust/target
LIBDIR = $(TARGET_DIR)/@LIBDIR@
STATLIB = $(LIBDIR)/libfreestiler.a
PKG_LIBS = -L$(LIBDIR) -lfreestiler

all: $(SHLIB) rust_clean

.PHONY: $(STATLIB)

$(SHLIB): $(STATLIB)

CARGOTMP = $(CURDIR)/.cargo
VENDOR_DIR = $(CURDIR)/vendor


# RUSTFLAGS appends --print=native-static-libs to ensure that
# the correct linkers are used. Use this for debugging if need.
#
# CRAN note: Cargo and Rustc versions are reported during
# configure via tools/msrv.R.
#
# Vendored/offline builds isolate CARGO_HOME. Online/CI builds keep the
# default cargo home so registry caches work across installs.
$(STATLIB):

	if [ "@USE_VENDOR@" = "true" ]; then \
		rm -Rf $(CARGOTMP); \
		if [ -d ./vendor ]; then \
			echo "=== Using offline vendor directory ==="; \
			mkdir -p $(CARGOTMP) && \
			cp rust/vendor-config.toml $(CARGOTMP)/config.toml; \
		elif [ -f ./rust/vendor.tar.xz ]; then \
			echo "=== Using offline vendor tarball ==="; \
			tar xf rust/vendor.tar.xz && \
			mkdir -p $(CARGOTMP) && \
			cp rust/vendor-config.toml $(CARGOTMP)/config.toml; \
		fi; \
	fi

	if [ -d ./vendor ]; then \
		find ./vendor -type f \( -name '._*' -o -name '.DS_Store' \) -delete; \
	fi

	if [ "@USE_VENDOR@" = "true" ]; then \
		export CARGO_HOME=$(CARGOTMP); \
	fi; \
	export PATH="$(PATH):$(HOME)/.cargo/bin" && \
	@MACOS_DEPLOYMENT@@PANIC_EXPORTS@RUSTFLAGS="$(RUSTFLAGS) --print=native-static-libs" cargo build @CRAN_FLAGS@ @FEATURES@ --lib @PROFILE@ --manifest-path=./rust/Cargo.toml --target-dir $(TARGET_DIR) @TARGET@

	if [ "@USE_VENDOR@" = "true" ]; then \
		rm -Rf $(CARGOTMP); \
	fi

rust_clean: $(SHLIB)
	rm -Rf $(VENDOR_DIR) @CLEAN_TARGET@
	if [ "@USE_VENDOR@" = "true" ]; then rm -Rf $(CARGOTMP); fi

clean:
	rm -Rf $(SHLIB) $(STATLIB) $(OBJECTS) $(TARGET_DIR) $(VENDOR_DIR) $(CARGOTMP)
